# Telegram 应用凭据：https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-your-api-hash

# 仅首次登录需要；已有授权 session 时可以留空。
TELEGRAM_PHONE=+8613800000000
TELEGRAM_PASSWORD=

# 完整 Bark 地址，例如 https://api.day.app/<device-key>
BARK_PUSH_URL=https://api.day.app/replace-with-your-device-key

# 可选设置
TELEGRAM_SESSION=telegram_session
APP_TIMEZONE=Asia/Shanghai
BARK_TIMEOUT_SECONDS=10

# 管理面板保护：绑定到非本机地址时请设置。
BARK_DASHBOARD_TOKEN=

# 日志：默认文件为 data/logs/bark-monitor.log。
BARK_LOG_LEVEL=INFO
# BARK_LOG_FILE 设置完整文件路径，或使用 BARK_LOG_DIR 指定目录。
BARK_LOG_FILE=
BARK_LOG_DIR=
BARK_LOG_MAX_BYTES=5242880
BARK_LOG_BACKUP_COUNT=5
BARK_LOG_TO_FILE=true
